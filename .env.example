# Optional frontend env for Vite builds
# VITE_API_URL=https://your-api.example.com/api
VITE_API_URL=http://localhost:3000/api

# Optional Google Maps browser key.
# Never commit the real key. Restrict it to http://localhost:8100/* and
# the deployed frontend origin before enabling embedded maps.
# VITE_GOOGLE_MAPS_API_KEY=
